        {
          "ruleId": "bandit/B105",
          "level": "note",
          "message": {
            "text": "Possible hardcoded password: 'demo-controller-token-123456'. Fix: Move the hard-coded password to a secret manager or environment variable. Details: https://bandit.readthedocs.io/en/1.9.4/plugins/b105_hardcoded_password_string.html"
          },
          "locations": [
