        {
          "ruleId": "bandit/B311",
          "level": "note",
          "message": {
            "text": "Standard pseudo-random generators are not suitable for security/cryptographic purposes.. Fix: Use the secrets module for tokens, keys and anything security-related. Details: https://bandit.readthedocs.io/en/1.9.4/blacklists/blacklist_calls.html#b311-random"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "demo_controller/control.py"
                },
                "region": {
