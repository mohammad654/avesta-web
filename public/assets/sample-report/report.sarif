        {
          "ruleId": "bandit/B110",
          "level": "note",
          "message": {
            "text": "Try, Except, Pass detected.. Fix: Handle or log the exception instead of silently passing. Details: https://bandit.readthedocs.io/en/1.9.4/plugins/b110_try_except_pass.html"
          },
          "locations": [
