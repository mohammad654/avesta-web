          ]
        },
        {
          "ruleId": "bandit/B404",
          "level": "note",
          "message": {
            "text": "Consider possible security implications associated with the subprocess module.. Fix: Only a review item: make sure subprocess is never called with untrusted input. Details: https://bandit.readthedocs.io/en/1.9.4/blacklists/blacklist_imports.html#b404-import-subprocess"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "demo_controller/control.py"
                },
