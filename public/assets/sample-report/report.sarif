          ]
        },
        {
          "ruleId": "hygiene/sbom",
          "level": "note",
          "message": {
            "text": "SBOM exists only as a generated file, not published with the repository. Fix: Avesta Proof generated sbom.cdx.json (2 components). Commit or attach it to every release (CRA Annex I Part II(1))."
          }
        }
      ]
    }
  ]
}